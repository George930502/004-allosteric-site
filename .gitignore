# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environment / secrets
.env
.env.local
*.pem
credentials.json

# Data: raw + interim are reproducible downloads/intermediates, never committed
data/raw/**
data/interim/**
data/external/**
